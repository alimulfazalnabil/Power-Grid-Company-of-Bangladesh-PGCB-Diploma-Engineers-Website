{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "declaration": true,
    "declarationMap": true,

    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "lib": ["DOM", "ES2022"],
    "types": ["react", "react-dom"]
  },
  "include": ["src"]
}
