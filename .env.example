# Environment configuration example for PGCB Portal

NODE_ENV=development
PORT=3000
API_PORT=8000
CMS_PORT=3001
POSTGRES_DB=pgcb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=StrongPassword123!
DATABASE_URL=postgresql://postgres:StrongPassword123!@postgres:5432/pgcb
REDIS_URL=redis://redis:6379
JWT_SECRET=ReplaceWithStrongSecret
JWT_REFRESH_SECRET=ReplaceWithAnotherStrongSecret
NEXT_PUBLIC_API_URL=http://localhost/api
SMTP_HOST=mailhog
SMTP_USER=mailhog
SMTP_PASSWORD=mailhog
AZURE_STORAGE_CONNECTION_STRING=
